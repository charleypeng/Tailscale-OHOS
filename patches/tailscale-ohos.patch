+// NetmapEndpointReport returns the endpoint addresses the coordination server
+// currently publishes for this node and for every peer, keyed by peer name.
+//
+// A direct path is only possible when the remote side advertises at least one
+// address the local host can reach, and magicsock resolves peer endpoints from
+// this netmap list plus whatever it learns from inbound discovery traffic.
+// Nothing else exposes the list: [ipnstate.PeerStatus.Addrs] is a deprecated
+// field that magicsock never fills for peers, so a relayed path cannot be
+// explained without reading the netmap itself.
+func (s *Server) NetmapEndpointReport() (self []string, peers map[string][]string) {
+	if err := s.Start(); err != nil || s.lb == nil {
+		return nil, nil
+	}
+	nm := s.lb.NetMapWithPeers()
+	if nm == nil {
+		return nil, nil
+	}
+	if selfNode := nm.SelfNode; selfNode.Valid() {
+		self = diagnosticAddrPorts(selfNode.Endpoints())
+	}
+	peers = make(map[string][]string, len(nm.Peers))
+	for _, peer := range nm.Peers {
+		peers[peer.Name()] = diagnosticAddrPorts(peer.Endpoints())
+	}
+	return self, peers
+}
+
+func diagnosticAddrPorts(endpoints views.Slice[netip.AddrPort]) []string {
+	addresses := make([]string, 0, endpoints.Len())
+	for _, endpoint := range endpoints.All() {
+		addresses = append(addresses, endpoint.String())
+	}
+	slices.Sort(addresses)
+	return addresses
+}
