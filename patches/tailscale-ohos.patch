+// guessHarmonyDefaultRouteInterface picks the local interface most likely to
+// carry the default route on a HarmonyOS phone, for the case where the host
+// application has not reported one yet (engine start happens before the
+// network manager answers).
+//
+// The carrier-facing data bearer always wins over Wi-Fi only when no Wi-Fi
+// interface has a usable address, which mirrors the usual preference for a
+// cheaper path; in practice both are acceptable answers, and the host
+// application corrects this as soon as it reports the real interface.
+func guessHarmonyDefaultRouteInterface() *net.Interface {
+	candidates, err := net.Interfaces()
+	if err != nil {
+		return nil
+	}
+	var best *net.Interface
+	bestScore := 0
