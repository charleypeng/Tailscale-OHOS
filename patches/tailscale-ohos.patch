+// isHarmonyOS reports whether this binary is built for OpenHarmony.
+//
+// It is a compile-time constant rather than a runtime.GOOS comparison on
+// purpose. The OpenHarmony Go toolchain reports GOOS as "linux" at runtime
+// (see src/internal/goos/zgoos_openharmony.go in the patched toolchain, which
+// defines GOOS = `linux` alongside IsOpenharmony = 1), so
+// `runtime.GOOS == "openharmony"` is always false and every branch guarded by
+// it is silently dead. The build tag, in contrast, follows the GOOS value the
+// build was launched with (GOOS=openharmony), so it does match.
+const isHarmonyOS = true
