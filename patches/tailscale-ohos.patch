+// destination NAT mapping behaviour and port-mapping availability). The result
+// is a single diagnostic line; it never contacts the network.
+func (s *Server) NetworkDiagnostics(ctx context.Context) string {
+	if err := s.Start(); err != nil {
+		return "FAILED | diagnostics | backend start"
+	}
+	if s.lb == nil {
+		return "FAILED | diagnostics | backend unavailable"
+	}
+	var b strings.Builder
+	if mc := s.lb.MagicConn(); mc != nil {
+		// configuredPort is the port the caller pinned in Server.Port; a
+		// localPort that differs from it means magicsock had to fall back to
+		// an ephemeral port, which is worth knowing because the announced
+		// "<public IP>:<local port>" candidate depends on it.
+		fmt.Fprintf(&b, "localPort=%d|configuredPort=%d", mc.LocalPort(), s.Port)
+		if rep := mc.GetLastNetcheckReport(ctx); rep != nil {
+			fmt.Fprintf(&b,
+				"|udp=%t|ipv4=%t|ipv6=%t|mappingVariesByDestIP=%s|upnp=%s|pmp=%s|pcp=%s"+
+					"|globalV4=%s|globalV6=%s|preferredDERP=%d|icmpV4=%t|captive=%s"+
+					"|v4Mappings=%s|derpLatency=%s",
+				rep.UDP, rep.IPv4, rep.IPv6,
+				rep.MappingVariesByDestIP, rep.UPnP, rep.PMP, rep.PCP,
+				diagnosticAddrPort(rep.GlobalV4), diagnosticAddrPort(rep.GlobalV6), rep.PreferredDERP,
+				rep.ICMPv4, rep.CaptivePortal,
+				diagnosticAddrPortCounters(rep.GlobalV4Counters, 4),
+				diagnosticDERPLatency(s.lb.DERPMap(), rep))
+		} else {
+			b.WriteString("|netcheck=unavailable")
+		}
+	}
+	if mon := s.lb.NetMon(); mon != nil {
+		if st := mon.InterfaceState(); st != nil {
+			fmt.Fprintf(&b, "|defaultIf=%s|haveV4=%t|haveV6=%t",
+				st.DefaultRouteInterface, st.HaveV4, st.HaveV6)
+			names := make([]string, 0, len(st.InterfaceIPs))
+			for name := range st.InterfaceIPs {
+				names = append(names, name)
+			}
+			slices.Sort(names)
