+// interfaceHasRoutableAddress reports whether ifc carries at least one
+// non-loopback, non-link-local unicast address. Interfaces without one cannot
+// reach a peer, so they must never be named as the default route.
+func interfaceHasRoutableAddress(ifc *net.Interface) bool {
+	addrs, err := ifc.Addrs()
+	if err != nil {
+		return false
+	}
+	for _, addr := range addrs {
+		ipNet, ok := addr.(*net.IPNet)
+		if !ok {
+			continue
+		}
+		ip, ok := netip.AddrFromSlice(ipNet.IP)
+		if !ok {
+			continue
+		}
+		ip = ip.Unmap()
+		if ip.IsLoopback() || ip.IsLinkLocalUnicast() || ip.IsLinkLocalMulticast() {
+			continue
+		}
+		return true
+	}
+	return false
 }
 
