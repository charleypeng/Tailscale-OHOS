+// isHarmonyProblematicInterface reports whether name belongs to an OpenHarmony
+// interface that peer-to-peer traffic can never use.
+//
+// A phone exposes more interfaces than a desktop Linux host, and several of
+// them carry routable-looking addresses that are worthless as discovery
+// candidates: the operator anchor interface (172.17.0.1 plus a matching IPv6
+// address), the IMS/VoLTE data bearer, and a set of virtual interfaces. Every
+// one of them ends up in the endpoint list magicsock announces, which both
+// wastes discovery pings and hides the addresses that can actually work.
+func isHarmonyProblematicInterface(name string) bool {
+	switch {
+	case strings.HasPrefix(name, "rmnet_ims"):
+		// IMS (VoLTE/VoNR) data bearer. It is a modem control plane
+		// interface with its own IPv6 prefix; it never carries user data.
+		return true
+	case strings.HasPrefix(name, "ancormnet"):
+		// Operator anchor interface (172.17.0.1/24 in the carriers we have
+		// samples for). The address is a device-local anchor, not a path.
+		return true
+	case name == "vpn-tun":
+		// The VPN interface this application itself creates. Its addresses
+		// belong to the tunnel, so advertising them as physical candidates
+		// would be circular.
+		return true
+	case name == "dummy0", strings.HasPrefix(name, "ifb"),
+		strings.HasPrefix(name, "ip_vti"), strings.HasPrefix(name, "ip6_vti"),
+		strings.HasPrefix(name, "ip6tnl"), strings.HasPrefix(name, "sit"),
+		strings.HasPrefix(name, "hw_sate_vnet"):
+		return true
+	}
 	return false
 }
 
