+// diagnosticDERPLatency reports the closest DERP regions by measured latency.
+// A node whose nearest region is on another continent has a measurement problem,
+// which also shows up as unusually slow relayed peer paths.
+func diagnosticDERPLatency(derpMap *tailcfg.DERPMap, report *netcheck.Report) string {
+	if derpMap == nil {
+		return "none"
+	}
+	latency := report.RegionLatency
+	if len(report.RegionV4Latency) > 0 {
+		latency = report.RegionV4Latency
+	}
+	regions := make([]int, 0, len(latency))
+	for id := range latency {
+		regions = append(regions, id)
+	}
+	slices.SortFunc(regions, func(x, y int) int {
+		return cmp.Compare(latency[x], latency[y])
+	})
+	if len(regions) > 4 {
+		regions = regions[:4]
+	}
+	entries := make([]string, 0, len(regions))
+	for _, id := range regions {
+		code := strconv.Itoa(id)
+		if region, ok := derpMap.Regions[id]; ok && region.RegionCode != "" {
+			code = region.RegionCode
+		}
+		entries = append(entries, fmt.Sprintf("%s=%dms", code, latency[id].Milliseconds()))
+	}
+	if len(entries) == 0 {
+		return "none"
+	}
+	return strings.Join(entries, ",")
+}
