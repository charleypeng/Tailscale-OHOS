+// NotifyNetworkChange asks the embedded network monitor to resample host
+// interfaces and waits until that sample has been published. This is intended
+// for application-sandboxed platforms whose native network callbacks are more
+// reliable than the netlink stream visible to the Go runtime.
+//
+// It returns whether an explicit socket rebind was needed. A rebind is always
+// performed when the caller observed a usable physical network: relying on
+// netmon's own change classification left magicsock on its previous sockets and
+// on a stale STUN endpoint, which pinned peers to a dead address and kept them
+// on DERP after a Wi-Fi <-> cellular switch.
+func (s *Server) NotifyNetworkChange(ctx context.Context) (explicitRebind bool, err error) {
+	if err := s.Start(); err != nil {
+		return false, err
+	}
+	if s.lb == nil || s.lb.NetMon() == nil {
+		return false, errors.New("tsnet: network monitor unavailable")
+	}
+	mon := s.lb.NetMon()
+	deltaCh := make(chan *netmon.ChangeDelta, 1)
+	unregister := mon.RegisterChangeCallback(func(delta *netmon.ChangeDelta) {
+		select {
+		case deltaCh <- delta:
+		default:
+		}
+	})
+	defer unregister()
+	mon.InjectEvent()
+	select {
+	case <-ctx.Done():
+		return false, ctx.Err()
+	case delta := <-deltaCh:
+		if delta == nil || !delta.AnyInterfaceUp() {
+			return false, errors.New("tsnet: no usable network interface")
+		}
+		// Rebind is cheap and idempotent: it reopens the UDP sockets, refreshes
+		// the STUN sample through netcheck, and clears every peer's endpoint
+		// state so direct paths are punched again.
+		if err := s.lb.DebugRebind(); err != nil {
+			return false, err
+		}
+		// The engine's own netmon callback already queued a rebind for the
+		// major changes it could see.
+		return !delta.RebindLikelyRequired, nil
+	}
+}
