+// TaildriveHTTPClient returns an HTTP client whose only destination is the
+// local Taildrive WebDAV endpoint. Connections are handed directly to the
+// in-process Taildrive filesystem instead of entering the HarmonyOS system
+// network or VPN route.
+func (s *Server) TaildriveHTTPClient() (*http.Client, error) {
+	if err := s.Start(); err != nil {
+		return nil, err
+	}
+	if s.taildriveFS == nil {
+		return nil, errors.New("tsnet: Taildrive filesystem unavailable")
+	}
+	fs := s.taildriveFS
+
+	transport := &http.Transport{
+		Proxy:               nil,
+		ForceAttemptHTTP2:   false,
+		MaxIdleConns:        4,
+		MaxIdleConnsPerHost: 4,
+		IdleConnTimeout:     60 * time.Second,
+		DialContext: func(_ context.Context, network, address string) (net.Conn, error) {
+			if network != "tcp" && network != "tcp4" && network != "tcp6" {
+				return nil, fmt.Errorf("tsnet: Taildrive unexpected network %q", network)
+			}
+			if address != "100.100.100.100:8080" {
+				return nil, fmt.Errorf("tsnet: Taildrive unexpected destination %q", address)
+			}
+
+			clientConn, serverConn := net.Pipe()
+			remoteAddr := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 0}
+			go func() {
+				if err := fs.HandleConn(serverConn, remoteAddr); err != nil {
+					_ = serverConn.Close()
+				}
+			}()
+			return clientConn, nil
+		},
+	}
+	return &http.Client{Transport: transport}, nil
+}
