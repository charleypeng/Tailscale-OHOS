+// harmonyInterfaceScore ranks interface names from a HarmonyOS phone. Higher is
+// a better default-route candidate; 0 means "do not use".
+func harmonyInterfaceScore(name string) int {
+	switch {
+	case name == "rmnet0", name == "rmnet1", name == "rmnet2":
+		// The cellular data bearers, in order of preference.
+		return 40 - int(name[len(name)-1]-'0')
+	case strings.HasPrefix(name, "rmnet_data"):
+		return 36
+	case strings.HasPrefix(name, "wlan"), strings.HasPrefix(name, "wifi"):
+		return 30
+	case strings.HasPrefix(name, "eth"), name == "usb0":
+		return 20
+	}
+	return 0
+}
