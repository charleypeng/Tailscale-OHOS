+// diagnosticAddrPortCounters lists the STUN-observed external addresses for the
+// current network. More than one distinct mapping, or a mapping whose port
+// differs from the local port, is what makes inbound hole punching unreliable.
+func diagnosticAddrPortCounters(counters map[netip.AddrPort]int, limit int) string {
+	if len(counters) == 0 {
+		return "none"
+	}
+	addresses := make([]string, 0, len(counters))
+	for address, count := range counters {
+		addresses = append(addresses, fmt.Sprintf("%s#%d", address, count))
+	}
+	slices.Sort(addresses)
+	if len(addresses) > limit {
+		addresses = addresses[:limit]
+	}
+	return strings.Join(addresses, ",")
